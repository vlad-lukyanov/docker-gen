{
  "name": "docker-gen",
  "version": "1.0.0",
  "description": "Dockerfile generator - create production-ready Dockerfiles with best practices",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write 'src/**/*.{js,css,html}' 'test/**/*.js'",
    "format:check": "prettier --check 'src/**/*.{js,css,html}' 'test/**/*.js'"
  },
  "license": "MIT",
  "devDependencies": {
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
